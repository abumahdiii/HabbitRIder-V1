# System Environment Variables

# Run-time Debug Mode (Must be true for dev environment to control system-level logging)
DEV_MODE=true

# Database Connection (Supabase/PostgreSQL or MongoDB)
DATABASE_URL="postgresql://postgres:password@localhost:5432/habbitrider"
# MONGODB_URI="mongodb://localhost:27017/habbitrider"

# Web3 / Crypto Payments Integration
NOWPAYMENTS_API_KEY="your_nowpayments_api_key_here"
NEXT_PUBLIC_METAMASK_RECEIVER_ADDRESS="0xYourWalletAddressHere"
